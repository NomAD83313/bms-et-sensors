FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY app/cameras/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY app/cameras/ ./

EXPOSE 3090
CMD ["gunicorn", "--config", "gunicorn.conf.py", "cameras_app:app"]
