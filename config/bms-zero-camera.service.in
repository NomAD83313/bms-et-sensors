[Unit]
Description=BMS Zero camera RTSP source
After=network.target

[Service]
Type=simple
User=@CAMERA_USER@
SupplementaryGroups=video render
ExecStart=/usr/local/bin/mediamtx /var/lib/bms-zero-camera/mediamtx.json
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
