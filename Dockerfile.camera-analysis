ARG ONNX_RUNTIME_IMAGE=onnx-cpu
FROM python:3.12-slim-bookworm AS onnx-cpu
RUN pip download --no-deps --dest /wheels onnxruntime==1.31.1
FROM ${ONNX_RUNTIME_IMAGE} AS onnx-package

# Build stage: PyTorch exists only here, to export the ONNX encoders (and pretrained weights).
FROM python:3.12-slim-bookworm AS exporter
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libgomp1 \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir torch==2.9.1 torchvision==0.24.1 --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir onnx==1.23.0 timm==1.0.31
ENV TORCH_HOME=/opt/torch HF_HOME=/opt/bms-camera/huggingface
WORKDIR /app
COPY app/cameras/ ./
RUN python export_feature_encoder.py /opt/bms-camera/encoders

# Runtime base: NumPy, Pillow, ONNX Runtime and FAISS only; the worker never imports PyTorch.
FROM python:3.12-slim-bookworm AS runtime-base
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libgomp1 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=onnx-package /wheels /tmp/onnx-wheels
RUN pip install --no-cache-dir Pillow==13.0.0 faiss-cpu==1.15.1 /tmp/onnx-wheels/*.whl \
    && rm -rf /tmp/onnx-wheels
COPY --from=exporter /opt/bms-camera/encoders /opt/bms-camera/encoders
ENV PYTHONUNBUFFERED=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
ENV CAMERA_ANOMALY_FEATURE_ENGINE=onnx CAMERA_ANOMALY_DISTANCE_ENGINE=faiss
ENV CAMERA_ANOMALY_MODEL_DIR=/opt/bms-camera/encoders
WORKDIR /app
COPY app/cameras/ ./

# Test image with the PyTorch reference (not built by Compose):
#   docker build -f Dockerfile.camera-analysis --target test -t bms-camera-analysis:test .
FROM runtime-base AS test
RUN pip install --no-cache-dir torch==2.9.1 torchvision==0.24.1 --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir onnx==1.23.0 timm==1.0.31
COPY --from=exporter /opt/torch /opt/torch
COPY --from=exporter /opt/bms-camera/huggingface /opt/bms-camera/huggingface
ENV TORCH_HOME=/opt/torch HF_HOME=/opt/bms-camera/huggingface HF_HUB_OFFLINE=1

# Default target: the analysis worker.
FROM runtime-base AS runtime
CMD ["python", "anomaly_worker.py"]
