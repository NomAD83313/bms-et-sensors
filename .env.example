INFLUX_ORG=my-org
INFLUX_BUCKET=daq_data
INFLUX_TOKEN=change-me
INFLUX_ADMIN_PASSWORD=change-me
GRAFANA_ADMIN_PASSWORD=change-me

# Where project app images come from: build = compile from this checkout (default;
# always matches the local code), pull = download prebuilt arm64 images from Docker Hub
# (nomad375/bms-*:latest; faster on a fresh Pi, but they are only as new as their last
# publication). A service without a published image is built locally. Non-arm64 hosts
# always build. A shell value overrides it: BMS_IMAGE_SOURCE=pull ./scripts/restart-local.sh
BMS_IMAGE_SOURCE=build

# Optional ports and dashboard tuning (defaults shown).
# DASHBOARD_PORT=80
# GRAF_APP_DEFAULT_RANGE=5m
# GRAF_APP_REFRESH_SEC=5
# Service controller: keep collectors (and the MSCL UI) running while their hardware
# is missing, and retry starting a degraded service every N seconds.
# SVCCTL_KEEP_DEGRADED_SERVICES_RUNNING=1
# SVCCTL_DEGRADED_START_RETRY_SEC=60.0

MSCL_NODE_IDS=16904,16900
# Optional fixed MSCL base station path. Prefer autodetect unless a host has
# multiple matching USB serial devices.
# MSCL_PORT=/dev/serial/by-id/...
# USB serial adapters MSCL must never probe: Silicon Labs pyrometers (10c4:834b)
# and the CH340 RS485 adapter of the WTVB01-485 vibration bus (1a86:7523).
MSCL_EXCLUDE_USB_IDS=10c4:834b,1a86:7523
# Keep the MSCL web UI available when no base station is connected.
# MSCL_UI_ALLOW_WITHOUT_SERIAL=1

# Optional device selection for hosts with multiple matching devices.
# ALMEMO_PORT=/dev/serial/by-id/...
# USB serial adapters ALMEMO autodetect must skip (default shown; same reason as MSCL).
# ALMEMO_EXCLUDE_USB_IDS=10c4:834b,1a86:7523
ALMEMO_BAUD=9600
# ALMEMO_DEVICE_NAME=almemo_logger
# Serial ports ALMEMO autodetect must skip (pyrometer udev names by default).
# ALMEMO_EXCLUDE_PORTS=/dev/ttyMICROEPS*,/dev/ttyOPTRIS*,/dev/ttyPYRO*
# REDLAB_ACTIVE_UNIQUE_ID=
# list = read all active channels in one call; any other value reads them one by one.
# REDLAB_READ_MODE=list
# Recovery when the RedLab USB device re-enumerates (0 disables it).
# REDLAB_REENUMERATION_RECOVERY=1
# REDLAB_REENUMERATION_CONFIRMATIONS=2
# REDLAB_REENUMERATION_DEBOUNCE_SECONDS=5.0
# REDLAB_REENUMERATION_RESTART_COOLDOWN_SECONDS=60.0

# Host-specific RCP settings. Use /dev/ttyOTBR with OTBR_RCP_TCP_ENDPOINT for
# network RCP bridges, or a stable /dev/serial/by-id/... path for USB RCP dongles.
OTBR_RCP_DEVICE=/dev/ttyOTBR
OTBR_RCP_TCP_ENDPOINT=10.42.0.2:6638
OTBR_RCP_BAUD=460800
# Optional Ethernet alias for the RCP web panel proxied by dashboard nginx.
OTBR_RCP_WEB_ALIAS_INTERFACE=eth0
OTBR_RCP_WEB_ALIAS_ADDRESS=10.42.1.2/24
# wlan0 is the local AP and Matter/Thread infrastructure interface.
# wlan1, when present, is reserved for optional internet uplink.
OTBR_INFRA_IF=wlan0
# OTBR_THREAD_IF=wpan0
# OTBR_LOG_LEVEL=5

MATTER_POLL_INTERVAL_SEC=60
# Battery (Power Source 47/11,12,26) is polled on every node endpoint that
# reports the BAT feature. MATTER_POLL_NODE_ID/MATTER_POLL_BATTERY_ENDPOINT_ID
# are always polled as a fallback, even before the node snapshot is available.
MATTER_POLL_NODE_ID=1
MATTER_POLL_BATTERY_ENDPOINT_ID=5
MATTER_PRIMARY_IF=wlan0
MATTER_BLE_MODE=internal
MATTER_INTERNAL_BLE_PREPARE=1
# Enable only for trusted development devices with test attestation certificates.
MATTER_SERVER_ENABLE_TEST_NET_DCL=false
# MATTER_BLE_MODE=disabled
# MATTER_SERVER_LOG_LEVEL=info
# MATTER_APP_PORT=3060
# MATTER_INFLUX_MEASUREMENT=matter_sensor
# Image override, for example to pin a matterjs-server release instead of :stable.
# MATTER_SERVER_IMAGE=ghcr.io/matter-js/matterjs-server:stable

# Messkluppe defaults. Use radio/0 on hosts with the real nRF24 receiver.
MESSKLUPPE_INPUT_MODE=mock
MESSKLUPPE_FAKE_MODE=1
# MESSKLUPPE_FAKE_INTERVAL_SEC=5.0
# MESSKLUPPE_CLIP_ID=1
# MESSKLUPPE_APP_PORT=3080
# MESSKLUPPE_INFLUX_MEASUREMENT=messkluppe_sensor
# nRF24 receiver wiring and radio (defaults shown).
# MESSKLUPPE_RADIO_SPI_BUS=0
# MESSKLUPPE_RADIO_SPI_DEVICE=0
# MESSKLUPPE_RADIO_CE_GPIO=25
# MESSKLUPPE_RADIO_SPI_SPEED_HZ=4000000
# MESSKLUPPE_RADIO_CHANNEL=111
# MESSKLUPPE_RADIO_PAYLOAD_SIZE=32
# MESSKLUPPE_RADIO_POLL_SEC=0.05
# Live-mode ACK command: after_rx re-sends it after each received payload, timer re-sends
# it every MESSKLUPPE_RADIO_COMMAND_REPEAT_SEC seconds.
# MESSKLUPPE_RADIO_LIVE_REPEAT_MODE=after_rx
# MESSKLUPPE_RADIO_COMMAND_REPEAT_SEC=0.25

# Vibration (WitMotion WTVB01-485, Compose profile "vibration"). Port, baud, poll
# interval and sensors are set in the /vibration/ UI (runtime/vibration/config.json).
# VIBRATION_INFLUX_MEASUREMENT=wtvb01
# Set to 1 to list the simulated vibration sensor ports (sim://...) for test sessions.
# VIBRATION_SIM_PORTS=0
# Simulated roll sensors (/graf/vibration sensor selector; started only when selected).
# Their addresses must not be used by a real sensor on the bus (defaults: the two highest).
# VIBRATION_SIM_SENSOR_ADDRESS=127
# VIBRATION_SIM_HEALTHY_ADDRESS=126
# InfluxDB write batching.
# VIBRATION_INFLUX_BATCH_SIZE=500
# VIBRATION_INFLUX_FLUSH_MS=1000

# Shared pyrometer USB/sensor serial mappings are bootstrapped from
# config/pyrometers-devices.example.json on every fresh host.
# thermoMETER CT / Optris collector tuning (defaults shown).
# THERMOMETER_BAUD=115200
# THERMOMETER_HTTP_PORT=3050
# THERMOMETER_POLL_SEC=0.2
# THERMOMETER_LOG_HZ=10
# THERMOMETER_STREAM_TIMEOUT_MS=50
# THERMOMETER_STREAM_STALE_SEC=3.0
# THERMOMETER_INFLUX_BATCH_SIZE=500
# THERMOMETER_INFLUX_FLUSH_MS=1000

# Host-specific AP settings. Change AP_INTERFACE if the AP Wi-Fi device is not wlan0.
AP_INTERFACE=wlan0
AP_WIFI_IPV4_CIDR=10.42.0.1/24
AP_ETH_IPV4_CIDR=10.42.1.1/24
AP_SSID=BMSensors
AP_PASSWORD=ChangeMe12345
AP_CHANNEL=4
# Priority of the AP profile over client profiles on the same interface (default 100).
# AP_AUTOCONNECT_PRIORITY=100
AP_LOCAL_DNS_NAME=rpi5.internal
# AP_UI_INTERFACE=wlan0
# AP_UI_PROFILE=rpi-ap
# AP_UI_PORT=3070
# Cameras (./scripts/restart-cameras.sh): camera-media runs every camera, camera-analysis
# analyses them. Cameras and their RTSP addresses are added in the UI at /cameras/ and kept in
# the private runtime file runtime/camera-manager/cameras.json, never in .env. The Raspberry Pi
# CSI camera (ID pi) is registered automatically when rpicam-vid is installed on the host.
CAMERA_CLIP_SECONDS=60
CAMERA_MAX_STORAGE_MB=10240
CAMERA_MAX_AGE_HOURS=24
# Pi camera recordings may live elsewhere (for example on a USB disk).
PI_CAMERA_RECORDING_DIR=./runtime/pi-camera/recordings
# Event video: seconds kept before and after an anomaly (rounded to segment boundaries).
CAMERA_EVENT_PRE_SEC=7
CAMERA_EVENT_POST_SEC=10
# Visual analysis: sample interval and confirmation frames.
CAMERA_ANOMALY_INTERVAL_SEC=0.2
CAMERA_ANOMALY_CONFIRM_FRAMES=2
# Frame gate: while the analysed area is unchanged, reuse the previous score instead of
# running the model (set CAMERA_ANOMALY_FRAME_GATE=0 to disable). A frame is evaluated when
# any 8x8 block of the area changes by BLOCK_DIFF grey levels, the area mean changes by
# MEAN_DIFF, or the last evaluation is older than MAX_AGE_SEC seconds. With GATE_ADAPTIVE=1
# each camera raises BLOCK_DIFF/MEAN_DIFF to its own measured noise (95th percentile x1.3),
# never above the *_MAX limits; a quiet camera keeps the values below.
CAMERA_ANOMALY_FRAME_GATE=1
CAMERA_ANOMALY_GATE_BLOCK_DIFF=3.0
CAMERA_ANOMALY_GATE_MEAN_DIFF=1.2
CAMERA_ANOMALY_GATE_MAX_AGE_SEC=2.0
CAMERA_ANOMALY_GATE_ADAPTIVE=1
CAMERA_ANOMALY_GATE_BLOCK_DIFF_MAX=12.0
CAMERA_ANOMALY_GATE_MEAN_DIFF_MAX=4.0
# Startup default before a 1–4 minute learning time is selected in the camera UI.
CAMERA_ANOMALY_NORMAL_FRAMES=60

# Analysis CPU tuning for a Raspberry Pi 5: one shared worker with a two-CPU quota.
CAMERA_ANOMALY_CPUS=2.0
# CAMERA_ANALYSIS_CPUS overrides CAMERA_ANOMALY_CPUS for the camera-analysis container.
# CAMERA_ANALYSIS_CPUS=2.0
# Optional CPU affinity; empty allows all available CPUs. Pi 5 split: analysis 2-3,
# preview/recording 0-1.
CAMERA_ANOMALY_CPUSET=2-3
CAMERA_MEDIA_CPUSET=0-1
CAMERA_ANOMALY_FEATURE_ENGINE=onnx
CAMERA_ANOMALY_DISTANCE_ENGINE=faiss
# auto selects XNNPACK when the installed runtime provides it, otherwise CPU.
CAMERA_ANOMALY_ONNX_PROVIDER=auto
# Model defaults for cameras without their own settings in the registry. Changing Draft or
# Top-K invalidates an existing baseline and requires learning the normal view again.
CAMERA_ANOMALY_THREADS=2
CAMERA_ANOMALY_JPEG_DRAFT=0
CAMERA_ANOMALY_TOP_K=1
CAMERA_ANOMALY_CORESET_SIZE=1024
# ONNX Runtime with XNNPACK (faster on Raspberry Pi). When this image is missing,
# restart-cameras.sh pulls nomad375/bms-onnx-xnnpack:ort-1.31.1-arm64 on arm64 and compiles
# locally only if that fails. Use onnx-cpu for the standard PyPI wheel without XNNPACK.
CAMERA_ONNX_RUNTIME_IMAGE=bms-onnx-xnnpack:local

# Cloudflare Tunnel (Compose profile `tunnel`, ./scripts/restart-tunnel.sh).
# Token of a remotely managed tunnel from Zero Trust -> Networks -> Tunnels.
# Keep the real value only in .env. See docs/remote-access.md.
CLOUDFLARE_TUNNEL_TOKEN=
