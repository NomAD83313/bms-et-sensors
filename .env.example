INFLUX_ORG=my-org
INFLUX_BUCKET=daq_data
INFLUX_TOKEN=change-me
INFLUX_ADMIN_PASSWORD=change-me
GRAFANA_ADMIN_PASSWORD=change-me

MSCL_NODE_IDS=16904,16900
# Optional fixed MSCL base station path. Prefer autodetect unless a host has
# multiple matching USB serial devices.
# MSCL_PORT=/dev/serial/by-id/...
MSCL_EXCLUDE_USB_IDS=10c4:834b

# Optional device selection for hosts with multiple matching devices.
# ALMEMO_PORT=/dev/serial/by-id/...
ALMEMO_BAUD=9600
# REDLAB_ACTIVE_UNIQUE_ID=

# Host-specific RCP settings. Use /dev/ttyOTBR with OTBR_RCP_TCP_ENDPOINT for
# network RCP bridges, or a stable /dev/serial/by-id/... path for USB RCP dongles.
OTBR_RCP_DEVICE=/dev/ttyOTBR
OTBR_RCP_TCP_ENDPOINT=10.42.0.2:6638
OTBR_RCP_BAUD=460800
# Optional Ethernet alias for the RCP web panel proxied by dashboard nginx.
OTBR_RCP_WEB_ALIAS_INTERFACE=eth0
OTBR_RCP_WEB_ALIAS_ADDRESS=10.42.1.2/24
# wlan0 is the local AP and Matter/Thread infrastructure interface.
# wlan1, when present, is reserved for optional internet uplink.
OTBR_INFRA_IF=wlan0

MATTER_POLL_INTERVAL_SEC=60
MATTER_POLL_NODE_ID=1
MATTER_POLL_BATTERY_ENDPOINT_ID=5
MATTER_PRIMARY_IF=wlan0
MATTER_BLE_MODE=internal
MATTER_INTERNAL_BLE_PREPARE=1
# Enable only for trusted development devices with test attestation certificates.
MATTER_SERVER_ENABLE_TEST_NET_DCL=false
# MATTER_BLE_MODE=disabled

# Messkluppe defaults. Use radio/0 on hosts with the real nRF24 receiver.
MESSKLUPPE_INPUT_MODE=mock
MESSKLUPPE_FAKE_MODE=1

# Shared pyrometer USB/sensor serial mappings are bootstrapped from
# config/pyrometers-devices.example.json on every fresh host.

# Host-specific AP settings. Change AP_INTERFACE if the AP Wi-Fi device is not wlan0.
AP_INTERFACE=wlan0
AP_WIFI_IPV4_CIDR=10.42.0.1/24
AP_ETH_IPV4_CIDR=10.42.1.1/24
AP_SSID=BMSensors
AP_PASSWORD=ChangeMe12345
AP_CHANNEL=4
AP_LOCAL_DNS_NAME=rpi5.internal
# AP_UI_INTERFACE=wlan0
# AP_UI_PROFILE=rpi-ap
# Optional camera profile (RTSP credentials must stay in the local .env).
CAMERA_URL=
CAMERA_RECORDING_DIR=./runtime/cameras/recordings
CAMERA_CLIP_SECONDS=60
CAMERA_MAX_STORAGE_MB=10240
CAMERA_MAX_AGE_HOURS=24
CAMERA_DASHBOARD_PORT=8082
# Optional low-resolution RTSP substream used only by the browser preview.
CAMERA_PREVIEW_PATH=/ch1
# Optional visual anomaly experiment: sample interval and normal-view frames.
CAMERA_ANOMALY_INTERVAL_SEC=0.2
CAMERA_ANOMALY_CONFIRM_FRAMES=2
# Frame gate: while the analysed area is unchanged, reuse the previous score instead of
# running the model (set CAMERA_ANOMALY_FRAME_GATE=0 to disable). A frame is evaluated when
# any 8x8 block of the area changes by BLOCK_DIFF grey levels, the area mean changes by
# MEAN_DIFF, or the last evaluation is older than MAX_AGE_SEC seconds.
CAMERA_ANOMALY_FRAME_GATE=1
CAMERA_ANOMALY_GATE_BLOCK_DIFF=3.0
CAMERA_ANOMALY_GATE_MEAN_DIFF=1.2
CAMERA_ANOMALY_GATE_MAX_AGE_SEC=2.0
# Startup default before a 1–4 minute learning time is selected in the camera UI.
CAMERA_ANOMALY_NORMAL_FRAMES=60
# Event-only video: anomaly or continuous; windows are rounded to segment boundaries.
CAMERA_RECORDING_MODE=anomaly
CAMERA_EVENT_PRE_SEC=7
CAMERA_EVENT_POST_SEC=10

# More cameras: add each RTSP address here under its own name (for example
# CAMERA_GARAGE_URL='rtsp://user:password@10.42.0.50:554/ch0') and reference the name from
# runtime/cameras.json; then run ./scripts/cameras-apply.sh (docs/camera-instances.md).

# Optional second camera: ./scripts/restart-pi-camera.sh (Raspberry Pi OS host).
# The source listens only on 127.0.0.1:8084; the second dashboard uses port 8083.
PI_CAMERA_RECORDING_DIR=./runtime/pi-camera/recordings
PI_CAMERA_DASHBOARD_PORT=8083
# Display label for the installed CSI module; does not change capture settings.
PI_CAMERA_DESCRIPTION=Sony IMX219
# Leave empty to follow CAMERA_RECORDING_MODE and use the same UI controls.
PI_CAMERA_RECORDING_MODE=

# Analysis CPU tuning for a Raspberry Pi 5: two threads and a two-CPU quota per worker.
CAMERA_ANOMALY_THREADS=2
CAMERA_ANOMALY_CPUS=2.0
# Optional CPU affinity; empty allows all available CPUs. Applies to both cameras
# unless overridden below. Pi 5 split: analysis 2-3, preview/recording 0-1.
CAMERA_ANOMALY_CPUSET=2-3
CAMERA_MEDIA_CPUSET=0-1
CAMERA_ANOMALY_FEATURE_ENGINE=onnx
CAMERA_ANOMALY_DISTANCE_ENGINE=faiss
# auto selects XNNPACK when the installed runtime provides it, otherwise CPU.
CAMERA_ANOMALY_ONNX_PROVIDER=auto
# Optional preprocessing and PatchCore score controls. Changing Draft or Top-K
# invalidates an existing baseline and requires learning the normal view again.
CAMERA_ANOMALY_JPEG_DRAFT=0
CAMERA_ANOMALY_TOP_K=1
CAMERA_ANOMALY_CORESET_SIZE=1024
# ONNX Runtime with XNNPACK (faster on Raspberry Pi). restart-cameras.sh and
# restart-pi-camera.sh build this image once if it is missing. Use onnx-cpu for
# the standard PyPI wheel without a local compile.
CAMERA_ONNX_RUNTIME_IMAGE=bms-onnx-xnnpack:local
# Pi-only overrides; benchmark before increasing these.
PI_CAMERA_ANOMALY_THREADS=2
PI_CAMERA_ANOMALY_CPUS=2.0
PI_CAMERA_ANOMALY_JPEG_DRAFT=1
PI_CAMERA_ANOMALY_TOP_K=5
PI_CAMERA_ANOMALY_CORESET_SIZE=1024
# Empty Pi CPUSET overrides inherit the common masks too.
# PI_CAMERA_ANOMALY_CPUSET=2-3
# PI_CAMERA_MEDIA_CPUSET=0-1
