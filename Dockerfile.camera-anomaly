FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libgomp1 \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir torch==2.9.1 torchvision==0.24.1 --index-url https://download.pytorch.org/whl/cpu
ENV PYTHONUNBUFFERED=1 TORCH_HOME=/opt/torch OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
RUN python -c "from torchvision.models import resnet18, ResNet18_Weights; resnet18(weights=ResNet18_Weights.DEFAULT)"
WORKDIR /app
COPY app/cameras/ ./
CMD ["python", "anomaly_worker.py"]
